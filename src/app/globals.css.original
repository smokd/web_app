/* Color Definitions */
:root {
  /* Text Colors */
  --text-primary: #f8fafc;  /* Bright white for dark mode */
  --text-secondary: #ffffff;  /* Fallback for elements */

  /* Accent Colors */
  --accent-primary: #3b82f6;  /* Bright blue for charts */;
  --accent-success: #10b981;  /* Green for success indicators */;
  --accent-warning: #f59e0b;  /* Amber for warnings */;
  --accent-danger: #ef4444;  /* Red for errors */

  /* Utility Colors */
  --bg-primary: #0f172a;  /* Dark background */
  --bg-secondary: #1e293b;  /* Secondary background */
  --border: #adb5bd;       /* Valid color for borders */
  --glass-bg: rgba(30, 41, 59, 0.7);
  --glass-border: rgba(255, 255, 255, 0.1);
  --glass-shadow: 0 6px 20px rgba(59, 130, 246, 0.23);
}

/* tn-primary:hover */
 tn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(59, 130, 246, 0.23);
  filter: brightness(1.1);
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease forwards;
}

/* Text Elements */
.text-medium {
  font-size: 1rem;
}

/* Glass Container */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  box-shadow: var(--glass-shadow);
  padding: 24px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.glass-panel:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 40px 0 rgba(0,0,0,0.45);
}

/* Charts Specific Styles */
.charts-container {
  background: var(--glass-bg);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 20px;
  box-shadow: var(--glass-shadow);
}

